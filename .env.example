# ==============================================================
# Generative AI NLP Productivity Toolkit - Environment Configuration
# ==============================================================

# Required: Your OpenAI API Key (Kept server-side only)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Identifier (default: gpt-4o-mini, supports gpt-3.5-turbo, gpt-4o, etc.)
OPENAI_MODEL=gpt-4o-mini

# Permitted CORS origins for the frontend (comma-separated or single URL)
FRONTEND_ORIGIN=http://localhost:5173

# Input character limit for user text (default: 10000)
MAX_INPUT_CHARS=10000

# Request timeout for OpenAI API calls in seconds (default: 30.0)
REQUEST_TIMEOUT_SECONDS=30.0

# Application environment: development or production
APP_ENV=development
